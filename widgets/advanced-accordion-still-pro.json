                        "items": [
                            {
                                "_id": "accrow1",
                                "item_title": "Can we start small?",
                                "item_default_open": "",
                                "item_id": "",
                                "item_icon": {
                                    "value": "",
                                    "library": ""
                                },
                                "item_content": "<p>Yes. Begin with the essentials and build at a comfortable pace. A focused first step makes the next decision easier.</p>",
                                "item_schema_text": ""
                            },
                            {
                                "_id": "accrow2",
                                "item_title": "What should I prepare?",
                                "item_default_open": "",
                                "item_id": "",
                                "item_icon": {
                                    "value": "",
                                    "library": ""
                                },
                                "item_content": "<p>Bring your goals, a few references and the questions you want to answer. Everything else can take shape as we work.</p>",
                                "item_schema_text": ""
                            },
                            {
                                "_id": "accrow3",
                                "item_title": "Can the direction evolve?",
                                "item_default_open": "",
                                "item_id": "",
                                "item_icon": {
                                    "value": "",
                                    "library": ""
                                },
                                "item_content": "<p>Of course. We make space to learn, test ideas and adjust the plan before committing to the finer details.</p>",
                                "item_schema_text": ""
                            },
                            {
                                "_id": "accrow4",
                                "item_title": "How do we stay in touch?",
                                "item_default_open": "",
                                "item_id": "",
                                "item_icon": {
                                    "value": "",
                                    "library": ""
                                },
                                "item_content": "<p>Short, thoughtful updates keep everyone aligned. Each milestone ends with a clear view of what comes next.</p>",
                                "item_schema_text": ""
                            }
                        ],
