                    "settings": {
                        "skin": "outline",
                        "items": [
                            {
                                "_id": "accrow1",
                                "item_title": "How do we choose a direction?",
                                "item_default_open": "",
                                "item_id": "",
                                "item_icon": {
                                    "value": "",
                                    "library": ""
                                },
                                "item_content": "<p>We look for the thread that connects your goals, your audience and your point of view. That becomes the starting point for a cohesive direction.</p>",
                                "item_schema_text": ""
                            },
                            {
                                "_id": "accrow2",
                                "item_title": "What if I need more time?",
                                "item_default_open": "",
                                "item_id": "",
                                "item_icon": {
                                    "value": "",
                                    "library": ""
                                },
                                "item_content": "<p>Good decisions deserve a little breathing room. We agree a realistic rhythm and leave space for reflection at the important moments.</p>",
                                "item_schema_text": ""
                            },
                            {
                                "_id": "accrow3",
                                "item_title": "Can I add the finishing touches?",
                                "item_default_open": "",
                                "item_id": "",
                                "item_icon": {
                                    "value": "",
                                    "library": ""
                                },
                                "item_content": "<p>Absolutely. The final details are where your voice comes through: a line of copy, a softer colour or a more generous space.</p>",
                                "item_schema_text": ""
                            },
                            {
                                "_id": "accrow4",
                                "item_title": "What does the handover include?",
                                "item_default_open": "",
                                "item_id": "",
                                "item_icon": {
                                    "value": "",
                                    "library": ""
                                },
                                "item_content": "<p>You receive an organised result, helpful context and a clear explanation of the choices that matter for future updates.</p>",
                                "item_schema_text": ""
                            }
                        ],
